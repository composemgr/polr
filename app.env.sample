# Polr environment configuration
# Copy to app.env and adjust values as needed

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=polr
BASE_DOMAIN_NAME=example.com
APP_PROTOCOL=https

# Application
APP_ORG_NAME=Polr
APP_SECRET_KEY=replace-with-a-random-secret-key-min-32-chars

# Admin credentials
APP_ADMIN_USER=admin
APP_ADMIN_PASS=replace-with-a-random-password

# Database (MySQL)
DB_CREATE_DATABASE_NAME=polr
DB_USER_NAME=polr
DB_USER_PASS=replace-with-a-random-password

# Allow anyone to create accounts
ALLOW_REGISTRATION=false

# Expose the API on the public interface
PUBLIC_INTERFACE=false
